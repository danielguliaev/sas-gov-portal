APP_ENV=development
AUTH_MODE=demo
DATABASE_PATH=./sas_portal.db
# Production requires AUTH_MODE=oidc and these parameters:
# OIDC_ISSUER=https://issuer.example
# OIDC_AUDIENCE=sas-gov-portal
# OIDC_JWKS_URL=https://issuer.example/keys
# OIDC_ROLES_CLAIM=roles
# Browser PKCE login requires the public-client OIDC contract:
# OIDC_AUTHORIZATION_URL=https://issuer.example/oauth2/authorize
# OIDC_TOKEN_URL=https://issuer.example/oauth2/token
# OIDC_CLIENT_ID=legal-library-public
# OIDC_REDIRECT_URI=https://library.example.org/
# OIDC_SCOPE=openid profile
# OIDC_LOGOUT_URL=https://issuer.example/logout
#
# Dedicated read-only game integration; set SHA-256 hex of a random secret:
# SERVICE_API_KEY_SHA256=
#
# Optional runtime controls:
# RATE_LIMIT_PER_MINUTE=240
# RATE_LIMIT_WINDOW_SECONDS=60
# ACCESS_LOG_JSON=1
